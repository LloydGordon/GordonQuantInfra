#!/usr/bin/env bash
# Bootstraps WireGuard without placing private keys in Terraform state.
set -euo pipefail

dnf install -y wireguard-tools iptables

cat >/etc/sysctl.d/99-wireguard-forwarding.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
SYSCTL
sysctl --system

install -d -m 0700 /etc/wireguard
umask 077

if [[ ! -s /etc/wireguard/server_private.key ]]; then
  wg genkey >/etc/wireguard/server_private.key
fi

wg pubkey </etc/wireguard/server_private.key >/etc/wireguard/server_public.key
server_private_key="$(cat /etc/wireguard/server_private.key)"
primary_interface="$(ip -o -4 route show to default | awk '{print $5; exit}')"

cat >/etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${wireguard_server_address}
ListenPort = ${wireguard_port}
PrivateKey = $server_private_key
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -A FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -A POSTROUTING -o $primary_interface -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -D FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -o $primary_interface -j MASQUERADE
%{ for peer in peers ~}

# ${peer.name}
[Peer]
PublicKey = ${peer.public_key}
AllowedIPs = ${join(", ", peer.allowed_ips)}
%{ endfor ~}
EOF

chmod 0600 /etc/wireguard/wg0.conf /etc/wireguard/server_private.key
systemctl enable --now wg-quick@wg0
systemctl enable --now amazon-ssm-agent
